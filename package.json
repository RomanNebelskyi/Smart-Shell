{
  "name": "smart-shell-mvp",
  "version": "1.0.0",
  "description": "A local CLI wrapper that intercepts errors from common commands (git, docker, npm, yarn, pnpm) and offers AI-generated fixes using OpenAI, Anthropic, or Ollama.",
  "type": "module",
  "bin": {
    "smart": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "dev": "ts-node src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Romannebelskyipz/smart-shell-mvp.git"
  },
  "keywords": [
    "cli",
    "ai",
    "devtools",
    "error-handling",
    "openai",
    "anthropic",
    "gemini",
    "ollama"
  ],
  "author": "Romannebelskyipz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Romannebelskyipz/smart-shell-mvp/issues"
  },
  "homepage": "https://github.com/Romannebelskyipz/smart-shell-mvp#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "ora": "^9.1.0"
  }
}
